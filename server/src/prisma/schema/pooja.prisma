model Pooja {
  id             String             @id @default(uuid())
  templeId       String
  baseAmount     Decimal            @db.Decimal(10, 2)
  imageKeys      String[]           @default([])
  poojaDay       String
  time           String
  isWeekly       Boolean            @default(false)
  weeklyDiscount Int?
  normalDiscount Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  bookings       Booking[]
  benefits       Benefit[]
  temple         Temple             @relation(fields: [templeId], references: [id])
  translations   PoojaTranslation[]

  @@index([templeId])
}

model PoojaTranslation {
  id       String   @id @default(uuid())
  poojaId  String
  language Language
  name     String
  about    String
  pooja    Pooja    @relation(fields: [poojaId], references: [id], onDelete: Cascade)

  @@unique([poojaId, language])
  @@index([language])
}
