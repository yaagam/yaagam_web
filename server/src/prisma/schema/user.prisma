model User {
  id                 String          @id @default(uuid())
  email              String?         @unique
  whatsappNumber     String?
  isWhatsappVerified Boolean         @default(false)
  provider           AuthProvider?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  zohoCustomerId     String?         @unique
  addresses          Address[]
  bookings           Booking[]
  privacyConsents    PrivacyConsent[]
  resolvedTickets    SupportTicket[] @relation("SupportTicketResolver")
  supportTickets     SupportTicket[]
  sessions           Session[]
}

model Session {
  id                         String    @id @default(uuid())
  userId                     String    @map("user_id")
  refreshTokenHash           String    @map("refresh_token_hash")
  previousRefreshTokenHash   String?   @map("previous_refresh_token_hash")
  previousRefreshTokenExpiry DateTime? @map("previous_refresh_token_expiry")
  createdAt                  DateTime  @default(now()) @map("created_at")
  expiresAt                  DateTime  @map("expires_at")
  revoked                    Boolean   @default(false)
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
