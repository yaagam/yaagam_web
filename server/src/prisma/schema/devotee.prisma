model Devotee {
  id          String   @id @default(uuid())
  userId      String
  name        String
  age         String
  nakshatra   String?
  naal        String?
  ritualState String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
