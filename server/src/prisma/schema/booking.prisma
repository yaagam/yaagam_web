model Booking {
  id                    String            @id @default(uuid())
  publicId              String            @unique @default(uuid())
  bookingNumber         String            @unique
  userId                String
  poojaId               String?
  templeId              String
  devoteeSnapshot       Json
  poojaSnapshot         Json
  templeSnapshot        Json
  addressSnapshot       Json
  bookingWhatsappNumber String
  type                  BookingType
  baseAmount            Decimal           @db.Decimal(10, 2)
  discountAmount        Decimal           @db.Decimal(10, 2)
  finalAmount           Decimal           @db.Decimal(10, 2)
  dakshinaAmount        Decimal           @default(0) @db.Decimal(10, 2)
  offeringTotal         Decimal           @default(0) @db.Decimal(10, 2)
  bookingDate           DateTime
  status                BookingStatus
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  sankalpa              String?
  poojaDate             DateTime
  pooja                 Pooja?            @relation(fields: [poojaId], references: [id])
  temple                Temple            @relation(fields: [templeId], references: [id])
  user                  User              @relation(fields: [userId], references: [id])
  transactions          Transaction[]
  offerings             BookingOffering[]
  devotees              BookingDevotee[]

  @@index([userId])
  @@index([status])
  @@index([bookingDate])
  @@index([poojaDate])
}

model BookingOffering {
  bookingId     String
  offeringId    String
  nameSnapshot  String
  priceSnapshot Decimal  @db.Decimal(10, 2)
  quantity      Int      @default(1)
  total         Decimal  @db.Decimal(10, 2)
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offering      Offering @relation(fields: [offeringId], references: [id])

  @@id([bookingId, offeringId])
  @@index([offeringId])
}
model BookingDevotee {
  id        String   @id @default(uuid())
  bookingId String
  name      String
  naal      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, position])
  @@index([bookingId])
}