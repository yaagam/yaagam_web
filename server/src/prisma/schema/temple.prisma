model Temple {
  id             String              @id @default(uuid())
  slug           String              @unique
  email          String              @default("")
  isActive       Boolean             @default(true)
  imageKey       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  state          String              @default("")
  description    String              @default("")
  zohoVendorId   String?             @unique
  zohoSyncStatus ZohoSyncStatus      @default(PENDING)
  zohoSyncError  String?
  lastZohoSyncAt DateTime?
  bookings       Booking[]
  poojas         Pooja[]
  translations   TempleTranslation[]

  @@index([isActive])
}

model TempleTranslation {
  id          String   @id @default(uuid())
  templeId    String
  language    Language
  name        String
  district    String
  place       String
  description String   @default("")
  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([templeId, language])
  @@index([language])
}
